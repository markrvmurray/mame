#!/bin/sh
# license:BSD-3-Clause
# copyright-holders:Mark Murray
#
# Headless wrapper for the llvm6309 subtarget on macOS.
#
# Usage:
#   ./mamellvm6309-headless <rom-image> [timeout-seconds]
#   ./mamellvm6309-headless --debug[=PORT] <rom-image>
#
# Serial output goes to stdout. The value written to the exit port ($FFD2)
# becomes the process exit code (0-255).
#
# Timeout defaults to 5 seconds (safety net — normal exit is via the $FFD2
# exit port). Bug #164 (debugger attach):
#   --debug          starts the gdbstub on port 2159 and runs without timeout.
#   --debug=NNNN     starts the gdbstub on the specified port instead.
# Once the gdbstub is listening, attach lldb (preferred) or gdb to it:
#   $ lldb path/to/test.elf
#   (lldb) gdb-remote localhost:2159
# gdb interop also works:
#   $ gdb path/to/test.elf -ex 'target remote :2159'
# Stderr prints the listen address as soon as MAME comes up.

set -e

# Parse --debug / --debug=PORT.
debug_mode=0
debug_port=2159
case "${1-}" in
    --debug)
        debug_mode=1
        shift
        ;;
    --debug=*)
        debug_mode=1
        debug_port=${1#--debug=}
        shift
        ;;
esac

if [ $# -lt 1 ]; then
    echo "usage: mamellvm6309-headless [--debug[=PORT]] <rom-image> [timeout-seconds]" >&2
    exit 1
fi

rom="$1"
timeout="${2:-5}"
here=$(dirname "$0")

# Temp files — cleaned up on exit.
outfile=$(mktemp /tmp/llvm6309_out.XXXXXX)
exitfile=$(mktemp /tmp/llvm6309_exit.XXXXXX)
# Bug #194 Phase C: cycle counting. The driver writes the HD6309's
# total_cycles() into LLVM6309_CYCLES_FILE on exit; we read it after
# MAME tears down and emit `cycles=<N>` to stderr — same format
# `usim09batch --cycles` uses, so the picolibc bench harness's
# CYCLES_RE regex picks it up without change.
cyclesfile=$(mktemp /tmp/llvm6309_cycles.XXXXXX)
trap 'rm -f "$outfile" "$exitfile" "$cyclesfile"' EXIT

if [ "$debug_mode" -eq 1 ]; then
    # gdbstub mode: drop -debugger none for -debugger gdbstub, drop the
    # runaway-safety -seconds_to_run (interactive sessions shouldn't time
    # out at 5 s), and skip catting the bitbanger after — the user is
    # driving with lldb / gdb.
    #
    # Note: debug execution PAUSES UNTIL a client connects, so the
    # process appears to hang on startup until you attach.
    echo "mamellvm6309 listening for gdb-RSP on localhost:${debug_port}" >&2
    echo "  attach with: lldb \"$rom\" -o 'gdb-remote localhost:${debug_port}'" >&2
    env SDL_VIDEO_DRIVER=dummy \
        LLVM6309_EXIT_FILE="$exitfile" \
        LLVM6309_CYCLES_FILE="$cyclesfile" \
        "${here}/mamellvm6309" llvm6309 \
            -video none \
            -sound none \
            -window \
            -nothrottle \
            -keyboardprovider none \
            -mouseprovider none \
            -lightgunprovider none \
            -joystickprovider none \
            -midiprovider none \
            -debugger gdbstub \
            -debugger_host localhost \
            -debugger_port "$debug_port" \
            -debug \
            -skip_gameinfo \
            -noplugins \
            -uifontprovider none \
            -rom "$rom" \
            -rs232 null_modem \
            -bitb "$outfile"
else
    env SDL_VIDEO_DRIVER=dummy \
        LLVM6309_EXIT_FILE="$exitfile" \
        LLVM6309_CYCLES_FILE="$cyclesfile" \
        "${here}/mamellvm6309" llvm6309 \
            -video none \
            -sound none \
            -window \
            -nothrottle \
            -keyboardprovider none \
            -mouseprovider none \
            -lightgunprovider none \
            -joystickprovider none \
            -midiprovider none \
            -debugger none \
            -skip_gameinfo \
            -noplugins \
            -uifontprovider none \
            -rom "$rom" \
            -rs232 null_modem \
            -bitb "$outfile" \
            -seconds_to_run "$timeout"

    cat "$outfile"

    # Bug #194 Phase C: emit `cycles=<N>` to stderr if the driver wrote
    # one. Format mirrors `usim09batch --cycles`; bench harnesses parse
    # both with the same regex.
    if [ -s "$cyclesfile" ]; then
        echo "cycles=$(cat "$cyclesfile")" >&2
    fi
fi

# Return the exit-port value as our exit code, OR 124 (GNU `timeout(1)`
# convention) when the test hit MAME's -seconds_to_run cap without
# writing the exit port. Matches usim09batch's rc=124-on-cap behavior;
# the picolibc bench harness (run-mc6809-tests) already reclassifies
# rc=124 as TIMEOUT rather than FAIL.
#
# Without this, slow tests that exceed the cap exit silently 0 and get
# recorded as false-positive OKs (with NULL cycles, since do_exit
# never fired to write the cycles file). Bug #194 Phase C surfaced
# this: visible after cycle-counting plumbing landed because the
# missing `cycles=` lines flagged the timeout cases that had been
# masquerading as passes.
if [ -s "$exitfile" ]; then
    exit_code=$(cat "$exitfile")
    exit "$exit_code"
fi
exit 124
