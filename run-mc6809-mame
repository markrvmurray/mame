#!/bin/sh
#
# run-mc6809-mame — lit-friendly wrapper around mamellvm6309-headless
#
# Usage: run-mc6809-mame <elf> [timeout-seconds]
#        run-mc6809-mame --debug[=PORT] <elf>          (Bug #258)
#
# Drop-in equivalent of `usim09batch <hex>` for HD6309 lit tests:
#   * accepts an ELF (the natural output of ld.lld),
#   * converts to a 64-KB raw cart `.bin` (objcopy --pad-to=0x10000),
#   * patches the reset vector at $FFFE to the ELF entry point if the
#     cart bytes there are zero (belt-and-braces — runtime.inc / crt0
#     usually places it already),
#   * invokes `mamellvm6309-headless`, returning its stdout/exit
#     unchanged.
#
# Debug mode (`--debug[=PORT]`): launches MAME with `--debug=PORT`
# (default 2159) and BLOCKS waiting for a gdb/lldb attach.  Installs
# trap handlers that SIGKILL the MAME PID on EXIT / INT / TERM so
# the script never leaks an orphan emulator (Bug #258).  Detects
# stale pidfiles from prior sessions on the same port and reclaims
# them if their recorded PID is dead.
#
# The lowest LOAD VMA (computed via `llvm-readelf -l`) determines where
# byte 0 of the ELF data lands inside the cart. Naïve `dd seek=0x100`
# would mis-place programs whose lowest segment is below $0100 (e.g.
# `.dp_data` at $0021 in picolibc tests with directpage enabled, see
# bug #200 retrospective).
#
# Environment:
#   MAMELLVM6309_HEADLESS  override path to mamellvm6309-headless
#                          (default: sibling of this script)
#   LLVM_OBJCOPY           override (default: llvm-objcopy on PATH)
#   LLVM_READELF           override (default: llvm-readelf on PATH)
#

set -e

debug_port=""
case "$1" in
    --debug)        debug_port="2159"; shift ;;
    --debug=*)      debug_port="${1#--debug=}"; shift ;;
esac

if [ $# -lt 1 ]; then
    cat >&2 <<EOF
usage: run-mc6809-mame <elf> [timeout-seconds]
       run-mc6809-mame --debug[=PORT] <elf>
EOF
    exit 1
fi

elf="$1"
timeout="${2:-5}"

here=$(cd "$(dirname "$0")" && pwd)
HEADLESS="${MAMELLVM6309_HEADLESS:-$here/mamellvm6309-headless}"
OBJCOPY="${LLVM_OBJCOPY:-llvm-objcopy}"
READELF="${LLVM_READELF:-llvm-readelf}"

if [ ! -x "$HEADLESS" ]; then
    echo "run-mc6809-mame: cannot find mamellvm6309-headless at $HEADLESS" >&2
    exit 1
fi

cart=$(mktemp /tmp/llvm6309-cart.XXXXXX)
raw=$(mktemp /tmp/llvm6309-raw.XXXXXX)
trap 'rm -f "$cart" "$raw"' EXIT

# objcopy -O binary emits bytes starting at the LOWEST LOAD VMA, with
# inter-segment gaps zero-filled. For an ELF whose lowest LOAD is e.g.
# $4000 (typical MC6809 lit Execution layout: .rom at $4000, vectors at
# $FFF0, no LOAD segment below), the raw output is only $C000 bytes
# and starts at memory offset $4000.
#
# MAME's `llvm6309` driver memcpy's the cart into address $0000 of the
# emulated address space, so we need a 64-KB image where byte N
# corresponds to memory address N. The fix is to prepend the raw output
# with a zero block sized to the lowest LOAD VMA, then pad the tail to
# exactly 64 KB.
# Pick the lowest LOAD program header whose FileSiz > 0. NOLOAD segments
# (e.g. .directpage at $0000 with FileSiz=0) get a program header but
# contribute no bytes to objcopy's binary output, so they must be
# skipped when computing the cart offset.
LOW_VMA=$("$READELF" -l "$elf" | awk '
    function hex2dec(s,    n, i, c, v) {
        sub(/^0x/, "", s)
        n = 0
        for (i = 1; i <= length(s); i++) {
            c = tolower(substr(s, i, 1))
            v = index("0123456789abcdef", c) - 1
            n = n * 16 + v
        }
        return n
    }
    /^[ \t]*LOAD/ {
        # Columns: Type Offset VirtAddr PhysAddr FileSiz MemSiz Flg Align
        filesiz = hex2dec($5)
        vaddr   = hex2dec($3)
        if (filesiz > 0 && (low == "" || vaddr < low_dec)) {
            low = $3
            low_dec = vaddr
        }
    }
    END { print low }
')
LOW_VMA_DEC=$(( ${LOW_VMA:-0x0} ))
"$OBJCOPY" -O binary --pad-to=0x10000 "$elf" "$raw"
# Compose the final 64-KB cart: $LOW_VMA_DEC zero bytes, then the raw
# output, truncated to exactly 64 KB.
if [ "$LOW_VMA_DEC" -gt 0 ]; then
    dd if=/dev/zero of="$cart" bs=1 count="$LOW_VMA_DEC" status=none
    cat "$raw" >> "$cart"
    # Truncate to exactly 64 KB.
    dd if="$cart" of="$cart.t" bs=1 count=65536 status=none 2>/dev/null
    mv "$cart.t" "$cart"
else
    mv "$raw" "$cart"
    : > "$raw"   # keep trap happy
fi

# Inject vector slots at known $FFF0-$FFFF locations by looking up the
# corresponding symbol via llvm-nm. Only fires if the existing cart
# bytes at the slot are zero (so it doesn't trample an ELF that already
# emitted a `.vectors` section, as the llvm-mc6809 lit Execution tests
# do — they use a custom link.ld with `.vectors` LOAD at $FFF0).
#
# Picolibc tests use a different linker script that PROVIDEs the .init
# entry stub at $FFC0 but does NOT emit .vectors at all, leaving the
# whole $FFF0-$FFFF range zero. The ELF entry point is also 0 (no
# ENTRY() in picolibc's link.ld), so we can't use that either.
#
# Slots handled:
#   $FFFE-$FFFF  reset                   _start
#   $FFF2-$FFF3  SWI3 (Bug #273)         __swi3_trap (picolibc crt0)
#
# Mirrors the same logic in the picolibc `run-mc6809` wrapper, which
# has done $FFFE injection since day one and $FFF2 injection since
# Bug #273 landed.
NM="${LLVM_NM:-llvm-nm}"
inject_vector() {
    vec_addr=$1   # decimal offset of the vector's high byte in the cart
    sym=$2
    vec_hi=$(dd if="$cart" bs=1 skip=$vec_addr count=1 2>/dev/null | od -An -tu1 | tr -d ' ')
    vec_lo=$(dd if="$cart" bs=1 skip=$((vec_addr+1)) count=1 2>/dev/null | od -An -tu1 | tr -d ' ')
    [ "$vec_hi" = "0" ] && [ "$vec_lo" = "0" ] || return 0
    addr=$("$NM" "$elf" 2>/dev/null | awk -v s="$sym" '$3==s {print $1; exit}')
    [ -n "$addr" ] || return 0
    hi_dec=$(( 0x$addr >> 8 & 0xFF ))
    lo_dec=$(( 0x$addr & 0xFF ))
    printf '\\%03o\\%03o' "$hi_dec" "$lo_dec" | xargs -0 printf '%b' | \
        dd of="$cart" bs=1 seek=$vec_addr count=2 conv=notrunc status=none
}
inject_vector 65534 _start         # $FFFE = reset vector
inject_vector 65522 __swi3_trap    # $FFF2 = SWI3 vector (Bug #273)

if [ -z "$debug_port" ]; then
    # Non-debug fast path: exec MAME headless with the cart-cleanup trap.
    exec "$HEADLESS" "$cart" "$timeout"
fi

# ---- debug mode (Bug #258) -------------------------------------------------
# Pattern that matches "the MAME instance bound to OUR debugger port".
# Used both for stale-orphan detection at startup and for cleanup on exit.
# The `mamellvm6309-headless` script spawns mamellvm6309 as a child (no exec)
# so killing the wrapper PID alone leaves MAME orphaned — match by the
# unique -debugger_port to find the actual binary regardless of wrapper
# ancestry.
mame_pattern="mamellvm6309 .*-debugger_port[ =]$debug_port"

# Reap any prior orphan MAME bound to our port (from a previous session
# that crashed). pkill returns 0 if anything matched, 1 if not.
if pgrep -f "$mame_pattern" >/dev/null 2>&1; then
    echo "run-mc6809-mame: orphan MAME on port $debug_port; reaping" >&2
    pkill -9 -f "$mame_pattern" 2>/dev/null || true
    # Brief settle so the port is released.
    sleep 1
fi

# Spawn the headless wrapper in the background; it in turn forks MAME.
"$HEADLESS" --debug="$debug_port" "$cart" &
wrapper_pid=$!

# Replace the cart-cleanup trap with one that ALSO reaps MAME. SIGKILL
# (not TERM) because MAME parked in gdbstub-wait ignores TERM (see the
# session-end notes in mame-gdbstub-debugging.md). Kill the headless
# wrapper AND any MAME child on our port — pgrep -P would miss MAME if
# it gets reparented to launchd; matching the port is robust.
cleanup_debug() {
    kill -9 "$wrapper_pid" 2>/dev/null || true
    pkill -9 -f "$mame_pattern" 2>/dev/null || true
    rm -f "$cart" "$raw"
}
trap cleanup_debug EXIT INT TERM

cat <<EOF
run-mc6809-mame: MAME gdbstub listening on localhost:$debug_port
                 cart=$cart  wrapper_pid=$wrapper_pid
                 attach with:
                   lldb -b -o 'target create $elf' \\
                              -o 'gdb-remote localhost:$debug_port' \\
                              -o run
                 (lldb must be the llvm-mc6809 build; Apple's lldb
                 rejects MC6809 ELFs — see mame-gdbstub-debugging.md)
                 use hardware breakpoints (-H); soft-bps misfire.
                 Ctrl-C this terminal to kill MAME.
EOF

# Wait for MAME to exit naturally (cart halt at \$FFD2 after lldb detach)
# or for a signal. The trap fires in both cases.
wait "$wrapper_pid"
exit $?
